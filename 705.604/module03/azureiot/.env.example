# Copy this file to .env (which git ignores) and fill in your own values.
# See readme.md for where to find each one.

# Producers (freezer_*-producer.py): the device connection string from IoT Hub > Devices > <device>.
# Each physical device (Orin, Raspberry Pi) gets its own .env with its own device's string.
IOTHUB_DEVICE_CONNECTION_STR=HostName=<your-hub>.azure-devices.net;DeviceId=<your-device>;SharedAccessKey=<your-key>

# Producers: your Govee developer API key.
GOVEE_API_KEY=<your-govee-api-key>

# Listener (client-listener.py): the Event Hub-compatible endpoint from IoT Hub > Built-in endpoints.
IOTHUB_EVENTHUB_CONNECTION_STR=Endpoint=sb://<something>.servicebus.windows.net/;SharedAccessKeyName=iothubowner;SharedAccessKey=<your-key>;EntityPath=<your-hub>
IOTHUB_EVENTHUB_NAME=<your-hub>
